[gd_scene format=3 uid="uid://oelbtcgjwi8n"]

[sub_resource type="GDScript" id="GDScript_u2sfu"]
script/source = "extends Node3D

@export var speed: float = 75.0
@export var min_duration: float = 0.05
@export var max_duration: float = 0.3

var _age := 0.0
var _duration := 0.1
var _base_scale := Vector3.ONE
var sections: Array[Node]

func _ready() -> void:
	sections = get_children()
	set_process(false)

func fire(from: Vector3, to: Vector3) -> void:
	var dist := from.distance_to(to)
	var section_distance = dist/sections.size()

func stretch_from_to(section: Node3D,from: Vector3, to: Vector3) -> void:
	pass

func _get_offset() -> void:
	pass

func _process(delta: float) -> void:
	_age += delta
	if _age >= _duration:
		VFX.release_line(self)
		return
	scale = _base_scale * (1.0 - _age / _duration)
"

