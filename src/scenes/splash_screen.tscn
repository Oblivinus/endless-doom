[gd_scene format=3 uid="uid://c86ginv8jw064"]

[sub_resource type="GDScript" id="GDScript_kvrig"]
script/source = "extends Control

@onready var made_by: Label = $ColorRect/Madeby
@onready var name_label: Label = $ColorRect/Name


func _ready() -> void:
	made_by.modulate.a = 0.0
	name_label.modulate.a = 0.0
	
	var fade_in: Tween = get_tree().create_tween().set_parallel()
	fade_in.tween_property(made_by, \"modulate:a\", 1.0, 1)
	fade_in.tween_property(name_label, \"modulate:a\", 1.0, 1)
	
	await fade_in.finished
	await get_tree().create_timer(0.5).timeout
	var fade_out := get_tree().create_tween().set_parallel()
	fade_out.tween_property(made_by, \"modulate:a\", 0.0, 1)
	fade_out.tween_property(name_label, \"modulate:a\", 0.0, 1)
	
	await fade_out.finished
	await get_tree().create_timer(0.25).timeout
	GameManager.change_playing(false)
"

