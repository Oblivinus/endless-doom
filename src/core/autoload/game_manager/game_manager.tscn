[sub_resource type="GDScript" id="GDScript_4q0ca"]
script/source = "extends Button

var tween: Tween

func  _init() -> void:
		mouse_entered.connect(_on_enter)
		mouse_exited.connect(_on_leave)
	
func _animate_scale(target: Vector2, duration: float = 0.1) -> void:
	if tween and tween.is_valid():
		tween.kill()
	tween = create_tween()
	tween.tween_property(self, \"scale\", target, duration)\\
		.set_trans(Tween.TRANS_QUAD)\\
		.set_ease(Tween.EASE_OUT)

func _on_enter():
	_animate_scale(Vector2(1.1, 1.1))
	#button.offset_transform_scale = Vector2(1.1, 1.1)

func _on_leave():
	_animate_scale(Vector2.ONE)
"

