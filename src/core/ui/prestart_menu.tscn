[sub_resource type="GDScript" id="GDScript_8ww2s"]
script/source = "extends CustomValueLabel

func set_value(value: float):
	value -= 1
	value = maxf(0.0, value)
	WaveManager.init_wave = int(value)
	display_label.text = \"%d\" % (WaveManager.init_wave + 1)
"

