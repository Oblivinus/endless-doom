[sub_resource type="GDScript" id="GDScript_kvrig"]
resource_name = "caco_fireball"
script/source = "extends DamageProjectile

func _on_hit(other: Node3D):
	var last_pos = global_position
	super(other)
	
	var vfx = VFX.new(\"caco_fireball_explosion\", last_pos)
	Globals.world.add_child(vfx)
	vfx._one_shot = true
	vfx.restart()
"

